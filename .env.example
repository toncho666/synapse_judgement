# Synapse Judgement - Environment Variables
# Copy this file to backend/.env and customize

# ============================================
# Backend Configuration
# ============================================

# Server
PORT=3001
NODE_ENV=development

# Database
# macOS (Homebrew, no password):
DATABASE_URL="postgresql://your_username@localhost:5432/synapse_judgement?schema=public"

# Linux/Windows (with password):
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/synapse_judgement?schema=public"

# Docker:
# DATABASE_URL="postgresql://synapse:synapse_password@localhost:5432/synapse_judgement?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="http://localhost:5173"

# Logging
LOG_LEVEL="debug"

# ============================================
# Frontend Configuration (optional)
# ============================================

# VITE_API_URL="http://localhost:3001"

# ============================================
# Docker Configuration (optional)
# ============================================

# POSTGRES_USER=synapse
# POSTGRES_PASSWORD=synapse_password
# POSTGRES_DB=synapse_judgement
