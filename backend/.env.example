# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# For macOS (Homebrew PostgreSQL without password):
DATABASE_URL="postgresql://your_username@localhost:5432/synapse_judgement?schema=public"

# For Linux/Windows (with password):
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/synapse_judgement?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
FRONTEND_URL="http://localhost:5173"

# Logging
LOG_LEVEL="debug"

# Twelve Data API (REQUIRED for technical analysis + stock quotes)
# Get your free API key at: https://twelvedata.com/pricing
# Free tier: 800 credits/day, 8 requests/minute
TWELVEDATA_API_KEY="your_twelvedata_api_key_here"

# News Sentiment API (Optional - news agent)
# Get your free API key at: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day, 1 request/second
ALPHA_VANTAGE_API_KEY="your_alpha_vantage_api_key_here"

# Earnings Call Transcripts API (Optional)
# Get your free API key at: https://finnhub.io/register
# Free tier: 60 calls/minute
FINNHUB_API_KEY="your_finnhub_api_key_here"
